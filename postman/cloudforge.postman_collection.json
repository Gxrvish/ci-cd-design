{
  "info": {
    "name": "CloudForge",
    "description": "CloudForge's HTTP API, M1 part (docs/api/dashboard.md, contracts/v1.yaml). Start the stack with `make up`.\n\nClick any request: it first creates the demo repository, project or build it needs (collection script). Run the whole collection (Runner) to see the full flow. After `make clean`, reset the variables.\n\nThe builds use a made-up commit. Once a runner exists (M1 slice 3) they fail at clone: put a real commit of your Gitea repository in `commitSha`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://cloudforge-console.localhost:8080"},
    {"key": "org", "value": "default"},
    {"key": "commitSha", "value": "3f786850e387550fdab836ed7e6dc881de23001b"},
    {"key": "newExternalId", "value": ""},
    {"key": "newProjectSlug", "value": ""},
    {"key": "externalId", "value": ""},
    {"key": "repositoryId", "value": ""},
    {"key": "projectSlug", "value": ""},
    {"key": "buildId", "value": ""},
    {"key": "registrationToken", "value": ""},
    {"key": "runnerCredential", "value": ""},
    {"key": "jobId", "value": ""},
    {"key": "attempt", "value": ""},
    {"key": "jobToken", "value": ""},
    {"key": "claimedBuildId", "value": ""},
    {"key": "logSeq", "value": "0"},
    {"key": "wrongToken", "value": "not-a-token"}
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Any request works on its own: the demo ids it uses are created first, if this collection has none yet.",
          "const vars = pm.collectionVariables;",
          "const used = pm.request.url.toString() + ((pm.request.body && pm.request.body.raw) || \"\") + JSON.stringify(pm.request.auth || {});",
          "const post = (path, body, save, token) => pm.sendRequest({",
          "    url: pm.variables.replaceIn(\"{{baseUrl}}\" + path),",
          "    method: \"POST\",",
          "    header: Object.assign({ \"Content-Type\": \"application/json\" }, token ? { Authorization: \"Bearer \" + token } : {}),",
          "    body: { mode: \"raw\", raw: JSON.stringify(body) },",
          "}, (error, response) => {",
          "    if (error || response.code >= 300) throw new Error(`demo data: POST ${path} failed (${error || response.code})`);",
          "    save(response.json());",
          "});",
          "const makers = {",
          "    repositoryId: (done) => {",
          "        const externalId = String(Date.now());",
          "        post(\"/api/orgs/{{org}}/repositories\", { provider: \"gitea\", external_id: externalId, full_name: \"cloudforge/hello\" },",
          "            (repository) => { vars.set(\"repositoryId\", repository.id); vars.set(\"externalId\", externalId); done(); });",
          "    },",
          "    projectSlug: (done) => ensure(\"repositoryId\", () => {",
          "        const slug = \"hello-\" + Date.now();",
          "        post(\"/api/orgs/{{org}}/projects\", { slug, name: \"Hello\", repository_id: Number(vars.get(\"repositoryId\")) },",
          "            () => { vars.set(\"projectSlug\", slug); done(); });",
          "    }),",
          "    buildId: (done) => ensure(\"projectSlug\", () =>",
          "        post(`/api/projects/${vars.get(\"projectSlug\")}/builds`, { commit_sha: vars.get(\"commitSha\") },",
          "            (build) => { vars.set(\"buildId\", build.id); done(); })),",
          "    registrationToken: (done) => post(\"/api/orgs/{{org}}/runner-tokens\", { pool: \"trusted\" },",
          "        (created) => { vars.set(\"registrationToken\", created.token); done(); }),",
          "    runnerCredential: (done) => ensure(\"registrationToken\", () =>",
          "        post(\"/v1/runners/register\", { name: \"postman\", capacity: 32 }, (runner) => {",
          "            vars.set(\"runnerCredential\", runner.credential); vars.unset(\"registrationToken\"); done();",
          "        }, vars.get(\"registrationToken\"))),",
          "    jobToken: (done) => ensure(\"runnerCredential\", () => ensure(\"projectSlug\", () =>",
          "        post(`/api/projects/${vars.get(\"projectSlug\")}/builds`, { commit_sha: vars.get(\"commitSha\") }, () =>",
          "            post(\"/v1/jobs/claim\", {}, (job) => { remember(job); done(); }, vars.get(\"runnerCredential\"))))),",
          "};",
          "makers.externalId = makers.repositoryId;",
          "makers.jobId = makers.attempt = makers.claimedBuildId = makers.jobToken;",
          "// A claim's build id is in its image name: <registry>/<org>/<project>:<sha12>-b<build>-a<attempt> (ADR-0008).",
          "function remember(job) {",
          "    [[\"jobId\", job.job_id], [\"attempt\", job.attempt], [\"jobToken\", job.job_token], [\"logSeq\", 0],",
          "     [\"claimedBuildId\", job.image.ref.match(/-b(\\d+)-a\\d+$/)[1]]].forEach(([name, value]) => vars.set(name, value));",
          "}",
          "function ensure(name, done) { vars.get(name) ? done() : makers[name](done); }",
          "const missing = Object.keys(makers).filter((name) => used.includes(`{{${name}}}`));",
          "(function next() { if (missing.length) ensure(missing.shift(), next); })();",
          "if (pm.request.body && pm.request.body.raw) {",
          "    pm.request.headers.upsert({ key: \"Content-Type\", value: \"application/json\" });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {"method": "GET", "url": "{{baseUrl}}/healthz"},
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Dashboard API (M1)",
      "item": [
        {
          "name": "Connect a Gitea repository",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/orgs/{{org}}/repositories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"gitea\",\n  \"external_id\": \"{{newExternalId}}\",\n  \"full_name\": \"cloudforge/hello\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set(\"newExternalId\", String(Date.now()));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"repositoryId\", pm.response.json().id);",
                  "pm.collectionVariables.set(\"externalId\", pm.collectionVariables.get(\"newExternalId\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a project",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/orgs/{{org}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"{{newProjectSlug}}\",\n  \"name\": \"Hello\",\n  \"repository_id\": {{repositoryId}}\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set(\"newProjectSlug\", \"hello-\" + Date.now());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"projectSlug\", pm.collectionVariables.get(\"newProjectSlug\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Trigger a build",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/projects/{{projectSlug}}/builds",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commit_sha\": \"{{commitSha}}\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"queued\", () => pm.expect(pm.response.json().state).to.eql(\"queued\"));",
                  "pm.collectionVariables.set(\"buildId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the build",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/builds/{{buildId}}"},
          "event": [
            {
              "listen": "test",
              "script": {"type": "text/javascript", "exec": ["pm.test(\"200\", () => pm.response.to.have.status(200));"]}
            }
          ]
        }
      ]
    },
    {
      "name": "Runner API (M1)",
      "item": [
        {
          "name": "Create a runner token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/orgs/{{org}}/runner-tokens",
            "body": {"mode": "raw", "raw": "{\n  \"pool\": \"trusted\"\n}", "options": {"raw": {"language": "json"}}}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"registrationToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a runner",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/runners/register",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{registrationToken}}", "type": "string"}]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman\",\n  \"labels\": [],\n  \"capacity\": 32\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"runnerCredential\", pm.response.json().credential);",
                  "pm.collectionVariables.unset(\"registrationToken\");  // one use only"
                ]
              }
            }
          ]
        },
        {
          "name": "Claim a job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/jobs/claim",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{runnerCredential}}", "type": "string"}]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 with a job, or 204 when nothing is queued\", () => pm.expect([200, 204]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "    const job = pm.response.json();",
                  "    [[\"jobId\", job.job_id], [\"attempt\", job.attempt], [\"jobToken\", job.job_token], [\"logSeq\", 0],",
                  "     [\"claimedBuildId\", job.image.ref.match(/-b(\\d+)-a\\d+$/)[1]]].forEach(([n, v]) => pm.collectionVariables.set(n, v));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Send a log line",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/jobs/{{jobId}}/attempts/{{attempt}}/logs",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{jobToken}}", "type": "string"}]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seq\": {{logSeq}},\n  \"text\": \"hello from Postman\\n\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 409) [\"jobId\", \"attempt\", \"jobToken\"].forEach((n) => pm.collectionVariables.unset(n));",
                  "pm.test(\"202 (a 409 means that job is finished: send again to claim a new one)\", () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) pm.collectionVariables.set(\"logSeq\", Number(pm.collectionVariables.get(\"logSeq\")) + 1);"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete the job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/jobs/{{jobId}}/attempts/{{attempt}}/complete",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{jobToken}}", "type": "string"}]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"result\": \"succeeded\",\n  \"image_digest\": \"sha256:abababababababababababababababababababababababababababababababab\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {"type": "text/javascript", "exec": ["pm.test(\"200\", () => pm.response.to.have.status(200));"]}
            }
          ]
        },
        {
          "name": "Read the log",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/builds/{{claimedBuildId}}/attempts/{{attempt}}/log"},
          "event": [
            {
              "listen": "test",
              "script": {"type": "text/javascript", "exec": ["pm.test(\"200\", () => pm.response.to.have.status(200));"]}
            }
          ]
        }
      ]
    },
    {
      "name": "Expected errors",
      "item": [
        {
          "name": "Claim without a credential: 401",
          "request": {"method": "POST", "url": "{{baseUrl}}/v1/jobs/claim"},
          "event": [
            {
              "listen": "test",
              "script": {"type": "text/javascript", "exec": ["pm.test(\"401\", () => pm.response.to.have.status(401));"]}
            }
          ]
        },
        {
          "name": "Log with a wrong token: 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/jobs/{{jobId}}/attempts/{{attempt}}/logs",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{wrongToken}}", "type": "string"}]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seq\": 0,\n  \"text\": \"x\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {"type": "text/javascript", "exec": ["pm.test(\"401\", () => pm.response.to.have.status(401));"]}
            }
          ]
        },
        {
          "name": "Same repository again: 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/orgs/{{org}}/repositories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"gitea\",\n  \"external_id\": \"{{externalId}}\",\n  \"full_name\": \"cloudforge/hello\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {"type": "text/javascript", "exec": ["pm.test(\"409\", () => pm.response.to.have.status(409));"]}
            }
          ]
        },
        {
          "name": "Slug shaped like a preview: 422",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/orgs/{{org}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"pr-1-hello\",\n  \"name\": \"Hello\",\n  \"repository_id\": {{repositoryId}}\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"refused by project_slug_check\", () => pm.expect(pm.response.json().detail[0].msg).to.eql(\"project_slug_check\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Branch name instead of a commit: 422",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/projects/{{projectSlug}}/builds",
            "body": {"mode": "raw", "raw": "{\n  \"commit_sha\": \"main\"\n}", "options": {"raw": {"language": "json"}}}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"refused by git_sha_check\", () => pm.expect(pm.response.json().detail[0].msg).to.eql(\"git_sha_check\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown build: 404",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/builds/999999999"},
          "event": [
            {
              "listen": "test",
              "script": {"type": "text/javascript", "exec": ["pm.test(\"404\", () => pm.response.to.have.status(404));"]}
            }
          ]
        }
      ]
    }
  ]
}
